#!/bin/bash

# Files a saved clip and makes its thumbnail. Takes JSON on stdin:
#
#   {"path": ".../Replay_2026-11-16_21-04-11.mp4",
#    "dir": "/home/you/Videos/Clips/Cs2",   (where it goes; "" keeps it in place)
#    "name": "Cs2 2026-11-16 21-04-11",      (file name without extension)
#    "thumbs": "/home/you/.cache/omarclip/thumbs"}
#
# Prints one JSON line: {"path", "thumb", "filed"}. A name already taken
# gets " (2)". If the clip can't be moved, it stays where the recorder wrote
# it, "path" says so and "filed" is false.

set -uo pipefail

request=$(cat)
path=$(jq -r '.path // ""' <<<"$request")
dir=$(jq -r '.dir // ""' <<<"$request")
name=$(jq -r '.name // ""' <<<"$request")
thumbs=$(jq -r '.thumbs // ""' <<<"$request")

[[ -f $path ]] || { echo "omarclip-file: no such clip" >&2; exit 1; }

filed=false
[[ -z $dir ]] && filed=true

if [[ -n $dir && -n $name && $name != */* ]] && mkdir -p -- "$dir"; then
  # mv -n skips a destination that exists, and depending on the coreutils
  # version still exits 0. So the move counts only once the clip has left
  # its old path for the new one; a name taken in the meantime means the
  # next name, anything else keeps the clip where it is.
  for (( n = 1; n <= 100; n++ )); do
    if (( n == 1 )); then target="$dir/$name.mp4"; else target="$dir/$name ($n).mp4"; fi
    [[ -e $target || -L $target ]] && continue
    mv -n -- "$path" "$target"
    if [[ ! -e $path && -f $target ]]; then
      path=$target
      filed=true
      break
    fi
    [[ -e $target || -L $target ]] || break
  done
fi
[[ $filed == true ]] || echo "omarclip-file: could not file the clip in $dir; it stays at $path" >&2

thumb=""
if [[ -n $thumbs ]] && command -v ffmpeg >/dev/null && mkdir -p -- "$thumbs"; then
  thumb="$thumbs/$(printf '%s' "$path" | sha1sum | cut -c1-16).jpg"
  # The last moment of the clip: what you pressed the key for.
  ffmpeg -v error -sseof -0.3 -i "$path" -frames:v 1 -vf "scale=480:-2" -q:v 4 -y "$thumb" </dev/null \
    || ffmpeg -v error -i "$path" -frames:v 1 -vf "scale=480:-2" -q:v 4 -y "$thumb" </dev/null \
    || thumb=""
fi

jq -cn --arg path "$path" --arg thumb "$thumb" --arg filed "$filed" '{path: $path, thumb: $thumb, filed: ($filed == "true")}'
