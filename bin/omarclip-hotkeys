#!/bin/bash
# Runs Omarclip's hotkey Lua in Hyprland, from JSON on stdin:
#   {"lua": "...", "stale": ".../toggles/hypr/omarclip.lua"}
# The binds are never saved where Hyprland's config loads them: a reload
# drops them, and Omarclip binds them again only after checking the binds in
# effect. `stale` is the binds file older versions saved there, removed so a
# reload can't bring those binds back unchecked. The Lua goes through
# hyprctl eval, so bind descriptions never show up in a process list.
set -uo pipefail

input=$(cat)
field() { jq -r --arg k "$1" '.[$k] // empty' <<<"$input"; }

stale=$(field stale)
case $stale in
  '') ;;
  /*/toggles/hypr/*.lua) rm -f -- "$stale" || { echo "omarclip-hotkeys: could not remove $stale" >&2; exit 1; } ;;
  *) echo "omarclip-hotkeys: stale must be a .lua file in a toggles/hypr folder" >&2; exit 2 ;;
esac

lua=$(field lua)
[[ -z $lua ]] || hyprctl eval "$lua"
